<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>عەبدولا جەلال سینەما</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Tahoma, sans-serif; }
        body { background-color: #121212; color: #fff; padding-bottom: 70px; }
        
        /* بەشی سەرەوە - بنەر */
        .hero { position: relative; width: 100%; height: 350px; background: linear-gradient(rgba(0,0,0,0.3), #121212), url('https://via.placeholder.com/600x350') center/cover; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; text-align: right; }
        .hero h2 { color: #e50914; font-size: 24px; margin-bottom: 5px; }
        .hero p { color: #ddd; font-size: 13px; margin-bottom: 15px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .watch-hero { background: #e50914; color: #fff; padding: 10px 20px; border-radius: 20px; text-decoration: none; width: fit-content; font-weight: bold; font-size: 14px; }

        /* بەشی ناونیشانی بەشەکان */
        .section-title { font-size: 18px; margin: 20px 15px 10px; text-align: right; border-right: 4px solid #e50914; padding-right: 10px; }

        /* لیستی فیلمەکان */
        .movies-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; padding: 0 15px; }
        .movie-card { background: #1f1f1f; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
        .movie-img { width: 100%; height: 200px; object-fit: cover; }
        .movie-info { padding: 10px; text-align: right; }
        .movie-title { font-size: 14px; font-weight: bold; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .movie-btn { display: block; background: #e50914; color: #fff; text-align: center; padding: 8px; border-radius: 5px; text-decoration: none; font-size: 13px; font-weight: bold; }

        /* بارەکە لە خوارەوە (Mobile Menu) */
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background-color: #1a1a1a; display: flex; justify-content: space-around; padding: 10px 0; border-top: 1px solid #333; z-index: 1000; }
        .nav-item { color: #aaa; text-decoration: none; font-size: 11px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px; }
        .nav-item span { font-size: 18px; }
        .nav-item.active { color: #e50914; }
    </style>
</head>
<body>

    <!-- بەشی سەرەکی (Banner) -->
    <div class="hero">
        <h2>سایلو (2023)</h2>
        <p>خەڵکی لەژێر زەویدا لەناو سایلۆیەکی زەبەلاحدا دەژین، کە چەندین یاسا و ڕێسای هەەیە...</p>
        <a href="لینکی_فیلم" target="_blank" class="watch-hero">▶ تەماشاکە بکە</a>
    </div>

    <!-- نوێترین ژێرنووسکراوەکان -->
    <h3 class="section-title">نوێترین ژێرنووسکراوەکان</h3>
    
    <div class="movies-grid">
        <!-- فیلمی یەکەم -->
        <div class="movie-card">
            <img src="https://via.placeholder.com/180x200" alt="پۆستەر" class="movie-img">
            <div class="movie-info">
                <div class="movie-title">شازادەی زەوی</div>
                <a href="لینکی_فیلم" target="_blank" class="movie-btn">سەیری بکە</a>
            </div>
        </div>

        <!-- فیلمی دووەم -->
        <div class="movie-card">
            <img src="https://via.placeholder.com/180x200" alt="پۆستەر" class="movie-img">
            <div class="movie-info">
                <div class="movie-title">پاشای کۆشک</div>
                <a href="لینکی_فیلم" target="_blank" class="movie-btn">سەیری بکە</a>
            </div>
        </div>
    </div>

    <!-- مێنوی خوارەوە (وەک وێنەکە) -->
    <div class="bottom-nav">
        <a href="#" class="nav-item"><span>👤</span>چوونە ژوورەوە</a>
        <a href="#" class="nav-item"><span>🎨</span>رەنگ</a>
        <a href="#" class="nav-item"><span>🔍</span>گەڕان</a>
        <a href="#" class="nav-item"><span>➕</span>زیاتر</a>
        <a href="#" class="nav-item active"><span>🏠</span>سەرەتا</a>
    </div>

</body>
</html>

